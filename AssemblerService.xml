<service>
  <id>AssemblerService</id>
  <name>Assembler Service</name>
  <description>Windchill Coversheets Assembler SOAP service</description>

  <executable>java</executable>
  <arguments>-jar "C:\AssemblerServiceApp-windows-service\AssemblerServiceApp.jar"</arguments>
  <workingdirectory>C:\AAssemblerServiceApp-windows-service</workingdirectory>

  <logpath>C:\AssemblerServiceApp-windows-service\logs</logpath>
  <log mode="roll" />

  <stoptimeout>35sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
</service>
